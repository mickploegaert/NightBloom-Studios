# Copy this file to .env.local and fill in your real Cloudflare Turnstile keys.
# Get them from https://dash.cloudflare.com/?to=/:account/turnstile
# Make sure to add your production domain (e.g. mkstudios.nl) to the widget's
# allowed hostnames, otherwise verification will fail in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_site_key_here
TURNSTILE_SECRET_KEY=your_secret_key_here
